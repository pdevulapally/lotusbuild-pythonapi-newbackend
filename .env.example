ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

E2B_API_KEY=
# Leave *_TEMPLATE blank to use E2B's default template for that sandbox kind.
E2B_CODE_TEMPLATE=
E2B_CODE_TIMEOUT=300
E2B_DESKTOP_TEMPLATE=
E2B_DESKTOP_TIMEOUT=300

# JSON contents of a Firebase service account key (not a file path).
FIREBASE_SERVICE_ACCOUNT_JSON=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=https://example.com/billing/success
BILLING_CANCEL_URL=https://example.com/billing/cancel
BILLING_PORTAL_RETURN_URL=https://example.com/billing

# Rate limiting (per-process-independent, Redis-backed) and idempotency.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ANON=60
RATE_LIMIT_MUTATE=20
RATE_LIMIT_WEBHOOK=100
IDEMPOTENCY_STALE_SECONDS=120
IDEMPOTENCY_TTL_HOURS=24

# Comma-separated allow-lists. Never "*" in production.
ALLOWED_HOSTS=*
ALLOWED_ORIGINS=

# Step-level SSE streaming (non-browser/fetch clients only - EventSource can't send Authorization).
SSE_POLL_INTERVAL_SECONDS=1

# Risk tiers / approval gates. Comma-separated regexes checked against bash commands.
RISKY_BASH_PATTERNS=rm\s+-rf,\bsudo\b,chmod\s+777,\|\s*sh\b,\|\s*bash\b,git\s+push\s+.*--force,>\s*/etc/,\bmkfs\b,\bdd\s+if=

# Context compaction.
COMPACTION_TOKEN_THRESHOLD=60000
COMPACTION_KEEP_LAST_N=10
COMPACTION_PROVIDER=anthropic
COMPACTION_MODEL=claude-haiku-5-5

# GitHub OAuth + PR integration.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://example.com/auth/github/callback
GITHUB_OAUTH_SUCCESS_REDIRECT_URL=https://example.com/github-linked

# Fernet key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Encrypts stored GitHub tokens at rest. OAuth state uses a separate one-time transaction.
CREDENTIAL_ENCRYPTION_KEY=

# Development only: opt in to the separate worker after reading docs/DURABLE_EXECUTION.md.
ENABLE_EXPERIMENTAL_WORKER=0
